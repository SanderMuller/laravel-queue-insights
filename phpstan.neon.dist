includes:
    - phpstan-baseline.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon

parameters:
    tmpDir: .cache/phpstan

    paths:
        - src
        - tests

    level: max

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 0
        declare: 100

    type_perfect:
        null_over_false: true
        no_mixed: false
        narrow_param: false
        narrow_return: true

    cognitive_complexity:
        class: 80
        function: 20

    strictRules:
        allRules: true

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false

        # Livewire's Testable became generic (`Testable<TComponent>`) in v4 but
        # was non-generic in v3. Our composer constraint is `^3.0 || ^4.0` so
        # PHPStan sees a different shape depending on which Livewire is locked
        # in the dev install:
        #   - PHPStan-on-v4 wants `@return Testable<TComponent>`
        #   - PHPStan-on-v3 rejects the generic as "Testable is not generic"
        # No single PHPDoc satisfies both. The helper below is local to one
        # test file; we ignore both error identifiers for that path so the
        # matrix stays green across the dual-Livewire support window.
        -
            identifier: missingType.generics
            path: tests/Feature/Http/DetailsModalTest.php
            reportUnmatched: false
        -
            identifier: generics.notGeneric
            path: tests/Feature/Http/DetailsModalTest.php
            reportUnmatched: false

        # Pest $this->fail() in closures — PHPStan can't resolve $this to TestCase
        -
            identifier: method.notFound
            path: tests/
            reportUnmatched: false

        # Pest framework internals — expect() chains use Pest's internal Expectation class
        -
            identifier: method.internalClass
            path: tests/
            reportUnmatched: false

        # Package `@internal` classes legitimately have unit tests. Scope
        # these suppressions to the specific test files so the rest of the
        # test tree still enforces the @internal boundary.
        -
            identifier: staticMethod.internalClass
            paths:
                - tests/Unit/Dashboard/
                - tests/Unit/QueueAggregatesTest.php
            reportUnmatched: false
        -
            identifier: return.internalClass
            paths:
                - tests/Unit/Dashboard/
                - tests/Unit/QueueAggregatesTest.php
                - tests/Feature/AlertingNotificationsTest.php
            reportUnmatched: false
        -
            identifier: new.internalClass
            paths:
                - tests/Unit/Dashboard/
                - tests/Unit/QueueAggregatesTest.php
                - tests/Feature/AlertingNotificationsTest.php
            reportUnmatched: false
        -
            identifier: property.internalClass
            paths:
                - tests/Feature/AlertingNotificationsTest.php
                - tests/Feature/AlertingDetectorsTest.php
                - tests/Feature/AlertingClassDetectorsTest.php
                - tests/Feature/AlertingBacklogGrowingTest.php
                - tests/Feature/AlertingTest.php
                - tests/Feature/Http/AlertsDashboardTest.php
            reportUnmatched: false
        -
            identifier: parameter.internalClass
            paths:
                - tests/Feature/AlertingClassDetectorsTest.php
                - tests/Feature/AlertingDetectorsTest.php
                - tests/Feature/AlertingNotificationsTest.php
            reportUnmatched: false
        # PHPUnit's AssertionFailedError / ExpectationFailedException are marked @internal
        # but legitimately referenced from tests when asserting on assertion failures
        -
            identifier: classConstant.internalClass
            path: tests/
            reportUnmatched: false
        # Pest higher-order expectations and test helpers return mixed
        -
            identifier: method.nonObject
            path: tests/
            reportUnmatched: false
        -
            identifier: staticMethod.dynamicCall
            path: tests/
            reportUnmatched: false
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: tests/
            reportUnmatched: false
        -
            identifier: property.nonObject
            path: tests/
            reportUnmatched: false
        -
            identifier: property.notFound
            path: tests/
            reportUnmatched: false

        # tests/Feature/QueueInsightsWorkSignalTest.php must use
        # `proc_open` + `posix_kill` to launch the supervisor as its
        # own subprocess and forward SIGTERM. The spec
        # (internal/specs/queue-insights-work-command.md §4.2) mandates
        # this pattern because in-process pcntl handling is unsafe
        # under PHPUnit's process model. The disallowed-calls extension
        # is otherwise the right default — scope the exception narrowly
        # to this one file.
        -
            identifier: disallowed.function
            path: tests/Feature/QueueInsightsWorkSignalTest.php
            reportUnmatched: false
        # SupervisorLauncher seeds APP_KEY via putenv before the Laravel
        # app boots — without it, CI fresh installs (no `.env` in the
        # testbench skeleton) abort before the supervisor's "Booting …"
        # line. Same narrow-scope exception as the signal test above.
        -
            identifier: disallowed.function
            path: tests/Fixtures/SupervisorLauncher.php
            reportUnmatched: false
        -
            identifier: staticMethod.void
            path: tests/Feature/QueueInsightsWorkSignalTest.php
            reportUnmatched: false
        -
            identifier: pest.redundantExpectation
            path: tests/Feature/QueueInsightsWorkSignalTest.php
            reportUnmatched: false
