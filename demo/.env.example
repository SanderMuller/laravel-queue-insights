APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Basic-auth gate for the public demo. Both must be set on Laravel Cloud
# to activate the gate; leaving either blank disables it (local dev
# default). Document the chosen credentials in README's Live demo section.
DEMO_BASIC_USER=
DEMO_BASIC_PASS=

# How long a seeded fixture set stays authoritative, in seconds. One
# request per window rewrites the Redis fixtures (~3,800 writes) and every
# other request reads what it wrote — without this the demo paid the full
# re-seed on every page load, which is 6-8 seconds against a managed Redis.
# The window is also the worst-case drift on the fixtures' relative
# timestamps ("2 minutes ago"), so keep it short. 0 re-seeds every request.
DEMO_SEED_WINDOW_SECONDS=120

# DATABASE — local dev keeps the default sqlite path (same file path as
# Laravel's skeleton ships with), which persists rows across requests so
# the Batches modal works. On Laravel Cloud, attach a managed DB resource
# (Postgres or MySQL) — Cloud injects DB_CONNECTION/DB_HOST/DB_PORT/
# DB_DATABASE/DB_USERNAME/DB_PASSWORD automatically.
#
# Do NOT use `DB_DATABASE=:memory:` on Cloud: each request would get a
# fresh in-memory database, and Livewire modal clicks hit /livewire/update
# in a separate request — the seeded `job_batches` rows would be missing
# and every batch would render the "Batch no longer tracked" empty state.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# queue-insights — turn on payload + pending-payload capture so the demo
# modals show structured-payload + ValueParser-decoded Context inline.
# See SECURITY.md before flipping these on in a production-like setup;
# `full` stores serialized command bodies (sanitized via redact_keys).
QUEUE_INSIGHTS_CAPTURE_PAYLOADS=full
QUEUE_INSIGHTS_PENDING_CAPTURE_PAYLOADS=full
# Show the "Redis memory" tile in the hero. Opt-in feature — sums
# `MEMORY USAGE` across every queue-insights key on the configured
# Redis connection, cached 60s. Cheap on the demo's bounded keyspace;
# document the SCAN cost before flipping on a busy production host.
QUEUE_INSIGHTS_REDIS_MEMORY_TILE=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
