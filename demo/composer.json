{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sandermuller/laravel-queue-insights-demo",
    "type": "project",
    "description": "Public demo app for sandermuller/laravel-queue-insights, deployed to Laravel Cloud.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^3.0",
        "predis/predis": "^2.2",
        "sandermuller/laravel-queue-insights": "@dev"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.6"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Workbench\\App\\": "../workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php bin/link-local-package.php"
        ],
        "post-update-cmd": [
            "@php bin/link-local-package.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
